# Local development values used by docker-compose. Don't use these in production.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-for-anything-but-local-development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DATABASE_URL=postgres://library:library@db:5432/library
CELERY_BROKER_URL=redis://redis:6379/0
RENTAL_PERIOD_DAYS=14
